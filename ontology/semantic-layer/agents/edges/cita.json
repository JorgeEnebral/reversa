{
  "name": "CITA",
  "description": "Arista de relación entre normas :Norma. Código BOE: 330.",
  "input_schema": {
    "type": "object",
    "properties": {
      "relacion_codigo": {
        "type": "integer",
        "description": "Código de relación BOE (330 = CITA)",
        "examples": [
          330
        ]
      },
      "relacion": {
        "type": "string",
        "description": "Texto que define la relación (CITA)",
        "examples": [
          "CITA"
        ]
      },
      "texto": {
        "type": "string",
        "description": "Descripción libre del alcance de la relación",
        "examples": [
          "los arts. 4 a 7 en su totalidad"
        ]
      }
    },
    "required": [
      "relacion_codigo",
      "relacion",
      "texto"
    ],
    "additionalProperties": false
  },
  "example": {
    "relacion_codigo": 330,
    "relacion": "CITA",
    "texto": "los arts. 4 a 7 en su totalidad"
  }
}