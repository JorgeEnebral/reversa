{
  "name": "MODIFICA",
  "description": "Arista de relación entre normas :Norma. Código BOE: 270.",
  "input_schema": {
    "type": "object",
    "properties": {
      "relacion_codigo": {
        "type": "integer",
        "description": "Código de relación BOE (270 = MODIFICA)",
        "examples": [
          270
        ]
      },
      "relacion": {
        "type": "string",
        "description": "Texto que define la relación (MODIFICA)",
        "examples": [
          "MODIFICA"
        ]
      },
      "texto": {
        "type": "string",
        "description": "Descripción libre del alcance de la relación",
        "examples": [
          "los arts. 4 a 7 en su totalidad"
        ]
      }
    },
    "required": [
      "relacion_codigo",
      "relacion",
      "texto"
    ],
    "additionalProperties": false
  },
  "example": {
    "relacion_codigo": 270,
    "relacion": "MODIFICA",
    "texto": "los arts. 4 a 7 en su totalidad"
  }
}